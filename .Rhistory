# Function to assign letters based on p-values
assign_letters <- function(pvalues, alpha = 0.05) {
groups <- unique(unlist(strsplit(names(pvalues), " - ")))
letters <- rep("", length(groups))
names(letters) <- groups
current_letter <- "a"
for (group in groups) {
similar_groups <- names(pvalues)[pvalues > alpha & grepl(group, names(pvalues))]
similar_groups <- unique(unlist(strsplit(similar_groups, " - ")))
new_letter <- FALSE
for (similar_group in similar_groups) {
if (letters[similar_group] != "") {
letters[group] <- letters[similar_group]
new_letter <- TRUE
}
}
if (!new_letter) {
letters[group] <- current_letter
current_letter <- letters[which(letters == current_letter)[1] + 1]
}
}
return(letters)
}
# Extract p-values from pairwise results
pairwise_pvalues <- pairwise_results$p.value
names(pairwise_pvalues) <- pairwise_results$comparison
# Assign letters
group_labels <- assign_letters(pairwise_pvalues)
print(group_labels)
